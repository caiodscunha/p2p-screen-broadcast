# Dependencies
node_modules/

# Electron build output
/dist/
/out/
/build/

# Módulo nativo (native/audio-loopback): ignora os artefatos intermediários
# de build (objs, vcxproj, etc.), mas mantém o .node compilado versionado —
# recompilar exige o workload C++ do Visual Studio Build Tools instalado.
native/*/build/*
!native/*/build/Release
native/*/build/Release/*
!native/*/build/Release/*.node

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
/logs

# Configuração local do Claude Code (permissões, settings pessoais) — nunca
# é código do projeto, não deveria subir pro repositório.
.claude/
